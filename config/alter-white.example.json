{
  "worker_count": 5,
  "repository_prefix": "team_",
  "branch": "main",
  "shallow_clone_depth": 1,
  "max_repo_size_mb": 2048,
  "max_file_size_kb": 512,
  "max_files_per_repo": 1200,
  "max_retries": 1,
  "evaluation_timeout_minutes": 20,
  "exclude_archived": true,
  "exclude_forks": true,
  "skip_patterns": [
    ".git/**",
    "node_modules/**",
    "vendor/**",
    "dist/**",
    "build/**",
    ".next/**",
    "coverage/**",
    "target/**",
    "out/**",
    "*.lock",
    "*.min.js",
    "*.min.css",
    "*.map",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.ico",
    "*.pdf",
    "*.zip",
    "*.gz",
    "*.sqlite",
    "*.db",
    "*.mp4",
    "*.mov",
    "*.woff",
    "*.woff2",
    "*.ttf"
  ]
}