{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alter-white.local/schemas/evaluation-1.1.0.json",
  "title": "Alter White Team Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_version",
    "status",
    "repository",
    "evaluation",
    "scores",
    "review_summary",
    "strengths",
    "improvement_areas",
    "verification",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "rubric_version": {
      "const": "1.1.0"
    },
    "status": {
      "const": "completed"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "url",
        "branch",
        "commit_sha"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "const": "main"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "evaluator",
        "mode"
      ],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluator": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "const": "static_inspection"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "ai",
        "technical_total",
        "ai_total",
        "total_score",
        "maximum_score"
      ],
      "properties": {
        "technical": {
          "$ref": "#/$defs/technical"
        },
        "ai": {
          "$ref": "#/$defs/ai"
        },
        "technical_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "ai_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "total_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "maximum_score": {
          "const": 50
        }
      }
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_review",
        "ai_review",
        "final_verdict"
      ],
      "properties": {
        "technical_review": {
          "type": "string",
          "minLength": 10,
          "maxLength": 350
        },
        "ai_review": {
          "type": "string",
          "minLength": 10,
          "maxLength": 350
        },
        "final_verdict": {
          "type": "string",
          "minLength": 10,
          "maxLength": 350
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 1
    },
    "improvement_areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "limitations",
        "project_proposal_status",
        "proposal_source"
      ],
      "properties": {
        "execution_status": {
          "const": "not_run_static_review"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_proposal_status": {
          "enum": [
            "read",
            "missing",
            "unreadable"
          ]
        },
        "proposal_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository-relative name of the proposal file that was read, e.g. project.pdf or project.docx. Null when no proposal file was found."
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "symbol",
        "observation",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 8
        },
        "status": {
          "enum": [
            "implemented",
            "partial",
            "mocked_or_hardcoded",
            "not_found",
            "unable_to_verify"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "minLength": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "maximum",
        "rationale",
        "evidence"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional_completeness",
        "architecture_and_design",
        "code_quality",
        "reliability_and_security",
        "integration_and_execution_evidence"
      ],
      "properties": {
        "functional_completeness": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 6
                },
                "score": {
                  "maximum": 6
                }
              }
            }
          ]
        },
        "architecture_and_design": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 5
                },
                "score": {
                  "maximum": 5
                }
              }
            }
          ]
        },
        "code_quality": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 5
                },
                "score": {
                  "maximum": 5
                }
              }
            }
          ]
        },
        "reliability_and_security": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 5
                },
                "score": {
                  "maximum": 5
                }
              }
            }
          ]
        },
        "integration_and_execution_evidence": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 4
                },
                "score": {
                  "maximum": 4
                }
              }
            }
          ]
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_centrality_and_relevance",
        "intelligence_and_ai_architecture",
        "context_and_data_grounding",
        "evaluation_and_guardrails",
        "resilience_and_adaptability"
      ],
      "properties": {
        "ai_centrality_and_relevance": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 5
                },
                "score": {
                  "maximum": 5
                }
              }
            }
          ]
        },
        "intelligence_and_ai_architecture": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 6
                },
                "score": {
                  "maximum": 6
                }
              }
            }
          ]
        },
        "context_and_data_grounding": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 5
                },
                "score": {
                  "maximum": 5
                }
              }
            }
          ]
        },
        "evaluation_and_guardrails": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 4
                },
                "score": {
                  "maximum": 4
                }
              }
            }
          ]
        },
        "resilience_and_adaptability": {
          "allOf": [
            {
              "$ref": "#/$defs/criterion"
            },
            {
              "properties": {
                "maximum": {
                  "const": 5
                },
                "score": {
                  "maximum": 5
                }
              }
            }
          ]
        }
      }
    }
  }
}
